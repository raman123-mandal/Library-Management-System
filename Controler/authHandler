//search book 

// 1. Handler Function
async function searchBooksHandler(req, res) {
  const query = req.query.q; // Form se 'q' naam ka input milega
  
  if (!query) {
    // Agar koi search query nahi hai, to khali page render karo
    return res.render('search');
  }

  try {
    // $regex ka use karke Title, Author, ya Category me partial match dhoondenge 
    // 'i' ka matlab hai case-insensitive (chote-bade letters ka farq nahi padega)
    const books = await Book.find({
      $or: [
        { title: { $regex: query, $options: 'i' } },
        { author: { $regex: query, $options: 'i' } },
        { category: { $regex: query, $options: 'i' } }
      ]
    });

    // Results ke sath search page render karo
    res.render('search', { books, query });
  } catch (error) {
    console.error("Search error:", error);
    res.status(500).send("Search karne me koi dikkat aayi.");
  }
}

// Borrow Book

async function handleBorrowBook(req, res) {
  const { bookId } = req.params;
  const studentId = req.user.id; 

  try {
    const book = await Book.findById(bookId);
    if (!book) {
      return res.redirect('/viewBooks?error=Book not found');
    }

    if (book.availableCopies <= 0) {
      return res.redirect('/viewBooks?error=No copies available');
    }

    // Same book returnDate: null ke sath check karein
    const existingBorrow = await Borrow.findOne({ studentId, bookId, returnDate: null });
    if (existingBorrow) {
      return res.redirect('/viewBooks?error=You already borrowed this book');
    }

    // 1. Due Date calculate karein (Maan lijiye book 14 din ke liye deni hai)
    const today = new Date();
    const durationInDays = 14; 
    const calculatedDueDate = new Date(today.getTime() + durationInDays * 24 * 60 * 60 * 1000);

    // 2. Book ki copy kam karein
    book.availableCopies -= 1;
    await book.save();

    // 3. Naya borrow record banayein (Sirf required fields ke sath)
    const borrowRecord = new Borrow({
      studentId: studentId,
      bookId: bookId,
      dueDate: calculatedDueDate // Yeh dena zaroori tha schema ke mutabik
      // Baaki saare fields (borrowDate, status, fine, returnDate) khud ba khud default set ho jayenge!
    });
    await borrowRecord.save();

    res.redirect('/viewBooks?message=Book borrowed successfully');
  } catch (error) {
    console.error('Borrow book error:', error);
    res.redirect('/viewBooks?error=Something went wrong');
  }
}

//return book

async function handleReturnBook(req, res) {
  const { borrowId } = req.params;

  try {
    const borrowRecord = await Borrow.findById(borrowId).populate('bookId');
    if (!borrowRecord) {
      return res.redirect('/viewBorrows?error=Borrow record not found');
    }

    if (borrowRecord.returnDate || borrowRecord.status === 'returned') {
      return res.redirect('/viewBorrows?error=Book already returned');
    }

    const today = new Date();
    borrowRecord.returnDate = today;
    borrowRecord.status = 'returned';

    if (today > borrowRecord.dueDate) {
      const daysLate = Math.ceil((today - borrowRecord.dueDate) / (1000 * 60 * 60 * 24));
      borrowRecord.fine = daysLate * 10;
    }

    await borrowRecord.save();

    const book = await Book.findById(borrowRecord.bookId._id);
    if (book) {
      book.availableCopies += 1;
      await book.save();
    }

    //  Student dashboard (/myBorrows) ki jagah Admin view (/viewBorrows) par bhejein
    res.redirect('/viewBorrows?message=Book returned successfully');

  } catch (error) {
    console.error('Return book error:', error);
    res.redirect('/viewBorrows?error=Something went wrong');
  }
}

//Admin Dashboard Handler

async function adminDashboardHandler(req,res) {
  try {
    // 1. Total Users ka count
    const totalUsers = await User.countDocuments({ role: 'Student' });

    // 2. Library me total unique books kitni hain
    const totalBooks = await Book.countDocuments({});

    // 3. Available Books (Saari books ke availableCopies ka sum)
    const booksData = await Book.aggregate([
      { $group: { _id: null, totalAvailable: { $sum: "$availableCopies" } } }
    ]);
    const availableBooks = booksData[0]?.totalAvailable || 0;

    // 4. Borrowed Books (Jo abhi tak returned nahi hui hain)
    const borrowedBooks = await Borrow.countDocuments({ status: 'borrowed' });

    // 5. Overdue Books (Status borrowed hai aur dueDate aaj se purani hai)
    const overdueBooks = await Borrow.countDocuments({
      status: 'borrowed',
      dueDate: { $lt: new Date() } // Aaj ki tarikh se choti date wale
    });

    // Saare data ko ek object me pack karke render karein
    res.render('adminDashboard', {
      stats: { totalUsers, totalBooks, availableBooks, borrowedBooks, overdueBooks }
    });

  } catch (error) {
    console.error("Dashboard error:", error);
    res.status(500).send("Dashboard data load karne me dikkat aayi.");
  }
}

//dashboard Handler

async function dashboardHandler(req, res) {
  try {
    const studentId = req.user.id;

    // 1. Saare ke saare borrow records le aao (chahe returned hon ya borrowed)
    const allBorrows = await Borrow.find({ studentId }).populate('bookId');

    // 2. Sirf wo kitabein jo abhi tak wapas nahi ki hain (Pending/Borrowed)
    const pendingBooksList = allBorrows.filter(book => book.status === 'borrowed');
    const pendingBooksCount = pendingBooksList.length;

    // 3. Sirf wo kitabein jo wapas ho chuki hain (Returned)
    const returnedBooksList = allBorrows.filter(book => book.status === 'returned');

    // 4. Kul milakar kitna fine (jurmana) hua hai (Saari entries ka total fine)
    const totalFine = allBorrows.reduce((sum, record) => sum + (record.fine || 0), 0);

    // EJS page render karein saare zaroori data ke sath
    res.render('dashboard', {
      borrowBooks: allBorrows,         // Saari list
      returnBooks: returnedBooksList,   // Sirf returned list
      pendingBooks: pendingBooksCount,  // Pending ka count
      totalFine: totalFine              // Total fine amount
    });

  } catch (error) {
    console.error("Dashboard error:", error);
    res.status(500).send("Dashboard load karne me koi dikkat aayi.");
  }
}


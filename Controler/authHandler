//Edit book

async function editBookHandler(req, res) {
  const { id } = req.params;
  try {
    const book = await Book.findById(id);
    if (!book) return res.status(404).json({ message: 'Book not found' });

    // Agar user page khol raha hai (GET request)
    if (req.method === 'GET') {
      return res.render('editBook', { user: req.user, book });
    }

    // Agar user form submit kar raha hai (POST request)
    const { title, author, isbn, availableCopies } = req.body;
    
    if (!title || !author || !isbn || !availableCopies) {
      return res.status(400).json({ message: 'All fields are required' });
    }

    // Database me values update karna
    book.title = title;
    book.author = author;
    book.isbn = isbn;
    book.availableCopies = availableCopies;
    
    await book.save();
    
    // Sahi route par redirect karna (jahan saari books dikhti hain)
    res.redirect('/viewBooks'); 
  } catch (error) {
    res.status(500).json({ message: error.message });
  }
}


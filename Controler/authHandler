//update profile

async function handleUpdateProfile(req, res) {
  const { name, email, newPassword } = req.body;
  try {
    if (!name || !email) {
      return res.redirect('/profile/edit?error=Fields cannot be empty');
    }

    // 1. Pehle variable ko achhe se declare karein
    let updateData = { name, email };

    // 2. Agar password badalna hai toh usko encrypt karke jodein
    if (newPassword && newPassword.trim() !== "") {
      const salt = await bcrypt.genSalt(10);
      updateData.password = await bcrypt.hash(newPassword, salt);
    }

    // 3. Database me update karein
    await User.findByIdAndUpdate(req.user.id, { $set: updateData });

    res.redirect('/profile?message=Profile updated successfully');
  } catch (error) {
    console.error("Profile update error:", error);
    res.redirect('/profile/edit?error=Something went wrong');
  }
}

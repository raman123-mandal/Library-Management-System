<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            display: flex;
            color: #333;
        }
        
        /* Sidebar Navigation Menu */
        .sidebar {
            width: 260px;
            background-color: #1a252f;
            height: 100vh;
            color: white;
            position: fixed;
            padding-top: 20px;
        }
        .sidebar h2 {
            text-align: center;
            font-size: 20px;
            margin-bottom: 30px;
            color: #ecf0f1;
        }
        .sidebar a {
            display: block;
            color: #bdc3c7;
            padding: 15px 20px;
            text-decoration: none;
            font-size: 16px;
            border-left: 4px solid transparent;
            transition: 0.3s;
        }
        .sidebar a:hover {
            background-color: #2c3e50;
            color: white;
            border-left: 4px solid #e74c3c; /* Admin Red Accent */
        }
        .sidebar a.logout {
            background-color: #c0392b;
            color: white;
            margin-top: 50px;
            text-align: center;
        }
        .sidebar a.logout:hover {
            background-color: #e74c3c;
        }

        /* Main Content Area */
        .main-content {
            margin-left: 260px;
            padding: 40px;
            width: calc(100% - 260px);
        }
        
        /* Stats Cards Styling */
        .stats-container {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }
        .card {
            flex: 1;
            min-width: 180px;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            text-align: center;
        }
        .card h3 { margin: 0; font-size: 15px; color: #777; }
        .card p { margin: 10px 0 0; font-size: 26px; font-weight: bold; color: #2c3e50; }
        .card.overdue p { color: #c0392b; }
        .card.users p { color: #2980b9; }
        .card.books p { color: #27ae60; }

        .welcome-header {
            margin-bottom: 30px;
            border-bottom: 2px solid #ddd;
            padding-bottom: 10px;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR MENU: AAPKE ROUTER KE ACCODRING PATHS HAIN -->
    <div class="sidebar">
        <h2>🛡️ Admin Panel</h2>
        <a href="/admin/dashboard">📊 Dashboard Home</a>
        <a href="/addbook">➕ Add New Book</a>
        <a href="/viewBooks">📚 Manage Books</a>
        <a href="/viewBorrows">🔄 View All Borrows</a>
        <a href="/profile">👤 Admin Profile</a>
        <a href="/logout" class="logout">🚪 Logout</a>
    </div>

    <!-- MAIN CONTENT AREA -->
    <div class="main-content">
        <div class="welcome-header">
            <h2>Welcome Admin, System Overview</h2>
        </div>

        <!-- Stats Section -->
        <div class="stats-container">
            <div class="card users">
                <h3>Total Users</h3>
                <p><%= stats.totalUsers %></p>
            </div>
            <div class="card books">
                <h3>Total Books</h3>
                <p><%= stats.totalBooks %></p>
            </div>
            <div class="card">
                <h3>Available Books</h3>
                <p><%= stats.availableBooks %></p>
            </div>
            <div class="card">
                <h3>Borrowed Books</h3>
                <p><%= stats.borrowedBooks %></p>
            </div>
            <div class="card overdue">
                <h3>Overdue Books</h3>
                <p><%= stats.overdueBooks %></p>
            </div>
        </div>
        
    </div>

</body>
</html>
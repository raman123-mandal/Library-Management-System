<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Borrow Records</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 40px;
      background-color: #f4f7f6;
      color: #333;
    }
    h2 {
      color: #333;
      margin-bottom: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      background-color: #fff;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
      border-radius: 6px;
      overflow: hidden;
    }
    th, td {
      padding: 12px 15px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #007bff;
      color: white;
      font-weight: 600;
    }
    tr:hover {
      background-color: #f9f9f9;
    }
    .status {
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: bold;
      text-transform: uppercase;
    }
    .status-borrowed {
      background-color: #fff3cd;
      color: #856404;
    }
    .status-returned {
      background-color: #d4edda;
      color: #155724;
    }
    .no-data {
      text-align: center;
      color: #777;
      padding: 20px;
    }
  </style>
</head>
<body>

  <h2>My Borrowed Books History</h2>

  <table>
    <thead>
    <tr>
        <th>Book Title</th>
        <th>Author</th>
        <th>Borrow Date</th>
        <th>Due Date</th>
        <th>Return Date</th>
        <th>Status</th>
        <th>Fine</th>
        <th>Action</th> <!-- Yeh aakhiri column jorna zaroori hai -->
    </tr>
</thead>
   <tbody>
  <% if (typeof borrows !== 'undefined' && borrows && borrows.length > 0) { %>
    <% borrows.forEach(function(record) { %>
      <tr>
        <!-- 1. Book Title -->
        <td><strong><%= record.bookId ? record.bookId.title : 'Book Deleted' %></strong></td>
        
        <!-- 2. Author (Agar popualte ho raha hai to title ki jagah author) -->
        <td><%= record.bookId ? record.bookId.author : 'N/A' %></td>
        
        <!-- 3. Borrow Date -->
        <td><%= new Date(record.borrowDate).toLocaleDateString('en-IN') %></td>
        
        <!-- 4. Due Date -->
        <td><%= new Date(record.dueDate).toLocaleDateString('en-IN') %></td>
        
        <!-- 5. Return Date (Agar return ho chuki hai to date dikhao, nahi to '-' dikhao) -->
        <td>
          <%= record.returnDate ? new Date(record.returnDate).toLocaleDateString('en-IN') : '-' %>
        </td>
        
        <!-- 6. Status -->
        <td>
          <span style="font-weight: bold; color: <%= record.status === 'returned' ? '#27ae60' : '#d35400' %>;">
            <%= record.status ? record.status.toUpperCase() : 'BORROWED' %>
          </span>
        </td>
        
        <!-- 7. Fine -->
        <td>₹<%= record.fine || 0 %></td>
        
        <!-- 8. Actions (Return Book Button) -->
        <td>
          <% if (record.status === 'borrowed') { %>
            <a href="/book/return/<%= record._id %>" style="background-color: #dc3545; color: white; padding: 6px 12px; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 13px; display: inline-block;">
              Return Book
            </a>
          <% } else { %>
            <span style="color: #28a745; font-weight: bold;">✔️ Done</span>
          <% } %>
        </td>
      </tr>
    <% }); %>
  <% } else { %>
    <tr>
      <td colspan="8" style="text-align: center; color: #999; padding: 20px;">
        Koi borrow record nahi mila.
      </td>
    </tr>
  <% } %>
</tbody>
</table>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            display: flex;
            color: #333;
        }
        
        /* Sidebar Navigation Menu */
        .sidebar {
            width: 250px;
            background-color: #2c3e50;
            height: 100vh;
            color: white;
            position: fixed;
            padding-top: 20px;
        }
        .sidebar h2 {
            text-align: center;
            font-size: 20px;
            margin-bottom: 30px;
            color: #ecf0f1;
        }
        .sidebar a {
            display: block;
            color: #bdc3c7;
            padding: 15px 20px;
            text-decoration: none;
            font-size: 16px;
            border-left: 4px solid transparent;
            transition: 0.3s;
        }
        .sidebar a:hover {
            background-color: #34495e;
            color: white;
            border-left: 4px solid #3498db;
        }
        .sidebar a.logout {
            background-color: #c0392b;
            color: white;
            margin-top: 50px;
            text-align: center;
        }
        .sidebar a.logout:hover {
            background-color: #e74c3c;
        }

        /* Main Content Area */
        .main-content {
            margin-left: 250px;
            padding: 40px;
            width: calc(100% - 250px);
        }
        
        /* Stats Cards Styling */
        .stats-container {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
        .card {
            flex: 1;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            text-align: center;
        }
        .card h3 { margin: 0; font-size: 16px; color: #777; }
        .card p { margin: 10px 0 0; font-size: 24px; font-weight: bold; color: #3498db; }
        .card.fine p { color: #e74c3c; }

        /* Table Styling */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            border-radius: 8px;
            overflow: hidden;
        }
        th, td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #34495e;
            color: white;
        }
        .status-borrowed { color: #f39c12; font-weight: bold; }
        .status-returned { color: #2ecc71; font-weight: bold; }
    </style>
</head>
<body>

    <!-- SIDEBAR NAVIGATION MENU -->
    <div class="sidebar">
        <h2>📚 Library System</h2>
        <a href="/dashboard">🏠 Dashboard</a>
        <a href="/viewBooks">📖 View Books</a>
        <a href="/search">🔍 Search Books</a>
        <a href="/myBorrows">🕒 My Borrows History</a>
        <a href="/profile">👤 View Profile</a>
        <a href="/profile/edit">⚙️ Update Profile</a>
        <a href="/admin/dashboard">🛡️ Admin Panel</a>
        <a href="/logout" class="logout">🚪 Logout</a>
    </div>

    <!-- MAIN CONTENT AREA -->
    <div class="main-content">
        <h2>Welcome to Your Dashboard</h2>

        <!-- Top Summary Cards -->
        <div class="stats-container">
            <div class="card">
                <h3>Total Books Issued</h3>
                <p><%= borrowBooks.length %></p>
            </div>
            <div class="card">
                <h3>Returned Books</h3>
                <p><%= returnBooks.length %></p>
            </div>
            <div class="card">
                <h3>Pending Return</h3>
                <p><%= pendingBooks %></p>
            </div>
            <div class="card fine">
                <h3>Total Fine</h3>
                <p>₹<%= totalFine %></p>
            </div>
        </div>

        <h3>Recent History</h3>
        <table>
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Fine</th>
                </tr>
            </thead>
            <tbody>
                <% if (borrowBooks && borrowBooks.length > 0) { %>
                    <% borrowBooks.forEach(function(record) { %>
                        <tr>
                            <td><strong><%= record.bookId ? record.bookId.title : 'Book Deleted' %></strong></td>
                            <td><%= new Date(record.borrowDate).toLocaleDateString('en-IN') %></td>
                            <td><%= new Date(record.dueDate).toLocaleDateString('en-IN') %></td>
                            <td>
                                <span class="status-<%= record.status %>">
                                    <%= record.status.toUpperCase() %>
                                </span>
                            </td>
                            <td>₹<%= record.fine || 0 %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="text-align: center; color: #999; padding: 20px;">
                            Aapka koi borrow record nahi mila.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

</body>
</html>
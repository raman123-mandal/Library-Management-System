<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Management System</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#f4f7fb;
}

/* Navbar */

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 60px;
background:#1e3a8a;
color:white;
position:sticky;
top:0;
}

.logo{
font-size:28px;
font-weight:bold;
}

.nav-btn a{
text-decoration:none;
margin-left:12px;
padding:10px 18px;
border-radius:8px;
color:white;
font-weight:bold;
}

.login{
background:#2563eb;
}

.register{
background:#10b981;
}

/* Hero */

.hero{
padding:70px 30px;
text-align:center;
background:white;
}

.hero h1{
font-size:45px;
color:#1e3a8a;
margin-bottom:15px;
}

.hero p{
font-size:18px;
color:#666;
margin-bottom:25px;
}

.search-box{
width:500px;
max-width:90%;
padding:14px;
border:1px solid #ccc;
border-radius:10px;
font-size:16px;
}

.hero-btn{
display:inline-block;
margin-top:20px;
padding:14px 30px;
background:#2563eb;
color:white;
text-decoration:none;
border-radius:10px;
font-weight:bold;
}

/* Features */

.features{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
padding:50px;
}

.feature{
background:white;
padding:30px;
text-align:center;
border-radius:15px;
box-shadow:0 3px 10px rgba(0,0,0,.1);
transition:.3s;
}

.feature:hover{
transform:translateY(-8px);
}

.feature h3{
margin:15px 0;
color:#1e3a8a;
}

/* Books */

.container{
padding:50px;
}

.container h2{
margin-bottom:30px;
color:#1e3a8a;
}

.book-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.book-card{

background:white;
padding:25px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
transition:.3s;

}

.book-card:hover{

transform:translateY(-8px);

}

.book-card h3{

color:#1e3a8a;
margin-bottom:15px;

}

.book-card p{

margin:8px 0;
color:#555;

}

.borrow-btn{

display:block;
margin-top:18px;
padding:12px;
text-align:center;
background:#10b981;
color:white;
text-decoration:none;
border-radius:10px;
font-weight:bold;

}

.borrow-btn:hover{

background:#059669;

}

/* Footer */

footer{

margin-top:60px;
background:#1e293b;
color:white;
text-align:center;
padding:30px;

}

</style>

</head>
<body>

<nav>

<div class="logo">
📚 LibraryMS
</div>

<div class="nav-btn">

<a href="/login" class="login">Login</a>

<a href="/register" class="register">Register</a>

</div>

</nav>

<section class="hero">

<h1>Digital Library Management System</h1>

<p>
Manage Books, Borrow Easily and Explore Your Favourite Collection.
</p>

<input
type="text"
class="search-box"
placeholder="Search books by title or author..."
>

<br>

<a href="#books" class="hero-btn">
Browse Books
</a>

</section>

<section class="features">

<div class="feature">

<h2>📚</h2>

<h3>Huge Collection</h3>

<p>Browse books from multiple categories.</p>

</div>

<div class="feature">

<h2>⚡</h2>

<h3>Fast Search</h3>

<p>Quickly find books by title or author.</p>

</div>

<div class="feature">

<h2>🔒</h2>

<h3>Secure Login</h3>

<p>JWT Authentication with Role Based Access.</p>

</div>

<div class="feature">

<h2>📖</h2>

<h3>Easy Borrow</h3>

<p>Borrow and Return Books in One Click.</p>

</div>

</section>

<section class="container" id="books">

<h2>Available Books</h2>

<div class="book-grid">

<% if(books && books.length>0){ %>

<% books.forEach(book=>{ %>

<div class="book-card">

<h3><%= book.title %></h3>

<p><strong>👤 Author :</strong> <%= book.author %></p>

<p><strong>🏷 Category :</strong> <%= book.category || "General" %></p>

<p><strong>📅 Published :</strong> <%= book.publishedYear %></p>

<p><strong>📚 Available :</strong> <%= book.availableCopies %> / <%= book.totalCopies %></p>

<a href="/borrow/<%= book._id %>" class="borrow-btn">
Borrow Book
</a>

</div>

<% }) %>

<% } else { %>

<h3>No Books Available</h3>

<% } %>

</div>

</section>

<footer>

<h3>📚 Library Management System</h3>

<br>

<p>
Built with Node.js • Express.js • MongoDB • EJS
</p>

<br>

<p>
© 2026 Ramanjeet Mandal
</p>

</footer>

</body>
</html>